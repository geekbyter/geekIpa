//
//  geekIpa.xcconfig
//  geekIpa
//
//  DEPLOYMENT_LOCATION=YES + DSTROOT 让产物固定落在
//  _build/Applications/geekIpa.app，CI 与 Makefile 都依赖这个路径。
//

GEEKIPA_PROJECT_VERSION=1.0.0
GEEKIPA_PRODUCT_BUNDLE_IDENTIFIER=com.geekipa.ios
GEEKIPA_DISAMBIGUATOR=${DEVELOPMENT_TEAM}

AD_HOC_CODE_SIGNING_ALLOWED = YES

DEPLOYMENT_LOCATION = YES
DSTROOT = $(SRCROOT)/_build/
